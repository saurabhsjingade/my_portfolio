# Site configuration
NEXT_PUBLIC_SITE_URL=https://saurabhjingade.com

# GitHub integration (optional — public endpoints work without a token,
# but adding one raises the rate limit from 60/hr to 5000/hr)
# Generate at: https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

# Analytics (optional — leave empty if not using)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
